{
  "name": "visual-muse",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "面向内容整理和多平台发布准备的 Electron 桌面工作台",
  "productName": "VisualMuse",
  "author": "imber",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imberZsk/visual-muse.git"
  },
  "homepage": "https://visual-muse-docs.netlify.app",
  "bugs": {
    "url": "https://github.com/imberZsk/visual-muse/issues"
  },
  "keywords": [
    "electron",
    "publishing",
    "markdown",
    "react",
    "vite",
    "desktop"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:base": "vite --host 127.0.0.1",
    "dev": "concurrently -k -n vite,electron \"pnpm run dev:base\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:electron": "concurrently -k -n vite,electron \"pnpm run dev:base\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "pnpm run build:ui",
    "build:ui": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "start": "pnpm run build:ui && cross-env NODE_ENV=production electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dist": "pnpm run build:ui && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --mac --arm64 --publish never",
    "dist:win": "pnpm run build:ui && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --x64 --publish never",
    "package": "pnpm run build:ui && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --dir",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "build": {
    "appId": "tech.visualmuse.publisher",
    "productName": "Visual Muse",
    "publish": [
      {
        "provider": "github",
        "owner": "imberZsk",
        "repo": "visual-muse"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "title": "Visual Muse ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "VisualMuse-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "VisualMuse-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "antd": "^6.0.0",
    "dayjs": "^1.11.13",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "concurrently": "^9.1.0",
    "cross-env": "^10.0.0",
    "electron": "42.5.2",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  }
}
