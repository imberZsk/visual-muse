{
  "name": "visual-muse",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "面向内容整理和多平台发布准备的 Electron 桌面工作台",
  "productName": "VisualMuse",
  "author": "imber",
  "license": "MIT",
  "packageManager": "pnpm@11.13.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imberZsk/visual-muse.git"
  },
  "homepage": "https://imber-visual-docs.netlify.app/visual-muse",
  "bugs": {
    "url": "https://github.com/imberZsk/visual-muse/issues"
  },
  "keywords": [
    "electron",
    "publishing",
    "markdown",
    "react",
    "vite",
    "desktop"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:base": "vite --host 127.0.0.1",
    "dev": "concurrently -k -n vite,electron \"pnpm run dev:base\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:electron": "concurrently -k -n vite,electron \"pnpm run dev:base\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "pnpm run build:ui",
    "build:ui": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "start": "pnpm run build:ui && cross-env NODE_ENV=production electron .",
    "test": "vitest run",
    "test:e2e": "pnpm run build:ui && playwright test",
    "test:e2e:headed": "pnpm run build:ui && playwright test --headed",
    "test:e2e:ui": "pnpm run build:ui && playwright test --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dist": "pnpm run build:ui && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --mac --arm64 --publish never",
    "dist:win": "pnpm run build:ui && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --x64 --publish never",
    "package": "pnpm run build:ui && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --dir",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mcp": "pnpm exec tsc -p tsconfig.node.json && node dist-electron/mcpServer.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "build": {
    "appId": "tech.visualmuse.publisher",
    "productName": "Visual Muse",
    "publish": [
      {
        "provider": "github",
        "owner": "imberZsk",
        "repo": "visual-muse"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/preload.cjs",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "VisualMuse-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "title": "Visual Muse ${version}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "VisualMuse-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "VisualMuse-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vitejs/plugin-react": "^6.0.3",
    "antd": "^6.5.1",
    "dayjs": "^1.11.21",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  }
}
